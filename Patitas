-- ==========================================
-- LÓGICA DEL AIMBOT
-- ==========================================
local aimKey = Enum.KeyCode.K
local isAiming = false

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == aimKey then
        isAiming = true
    end
end)

UserInputService.InputEnded:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == aimKey then
        isAiming = false
    end
end)

-- Función para obtener el enemigo más cercano al centro de la pantalla
local function getClosestTarget()
    local closest = nil
    local shortestDist = config.AimbotFOV
    local center = Camera.ViewportSize / 2
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local head = player.Character:FindFirstChild("Head")
            local humanoid = player.Character:FindFirstChild("Humanoid")
            
            if head and humanoid and humanoid.Health > 0 then
                local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
                if onScreen then
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        closest = head
                    end
                end
            end
        end
    end
    return closest
end

-- Bucle del Aimbot
RunService.RenderStepped:Connect(function()
    if config.Aimbot and isAiming then
        local target = getClosestTarget()
        if target then
            local targetPos = target.Position
            local currentCFrame = Camera.CFrame
            local goalCFrame = CFrame.new(currentCFrame.Position, targetPos)
            
            -- Suavizado
            Camera.CFrame = currentCFrame:Lerp(goalCFrame, config.AimbotSmoothness)
        end
    end
end)

-- ==========================================
-- LÓGICA DEL ESP (Resaltado)
-- ==========================================
local espHighlights = {}

local function updateESP()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local character = player.Character
            local humanoid = character:FindFirstChild("Humanoid")
            
            if humanoid and humanoid.Health > 0 then
                if config.ESP then
                    if not espHighlights[player] then
                        local highlight = Instance.new("Highlight")
                        highlight.Name = "HackESP"
                        highlight.FillColor = Color3.fromRGB(255, 0, 0)
                        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                        highlight.FillTransparency = 0.5
                        highlight.OutlineTransparency = 0
                        highlight.Adornee = character
                        highlight.Parent = character
                        espHighlights[player] = highlight
                    end
                else
                    if espHighlights[player] then
                        espHighlights[player]:Destroy()
                        espHighlights[player] = nil
                    end
                end
            end
        end
    end
end

-- Limpiar ESP al salir jugadores
Players.PlayerRemoving:Connect(function(player)
    if espHighlights[player] then
        espHighlights[player]:Destroy()
        espHighlights[player] = nil
    end
end)

